# Use another free port (e.g. 4001) if 4000 is already taken locally.
PORT=4000
NODE_ENV=development
# Optional. Leave empty for Node's default (all interfaces).
# On a VPS behind nginx/Caddy, prefer: LISTEN_HOST=127.0.0.1
# Platforms that require binding all interfaces can use: LISTEN_HOST=0.0.0.0
# LISTEN_HOST=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Empty OK for local MySQL. Required (non-empty) when NODE_ENV=production.
DB_PASSWORD=
DB_NAME=miracle_times

# Development: any string ≥16 chars. Production: unique random secret ≥32 chars.
# Generate: openssl rand -base64 48
# Never reuse example placeholders in production — the API will refuse to start.
JWT_SECRET=change-me-to-a-long-random-string
# Cookie maxAge matches this value (e.g. 1d, 12h, 30m, or seconds like 86400).
JWT_EXPIRES_IN=1d
COOKIE_NAME=mt_token
# Optional. Prefer host-only cookies on api.miracletimes.in.
# Set only when intentionally sharing across subdomains (e.g. .miracletimes.in).
# COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
# Comma-separated exact origins (no wildcards). Required + HTTPS-only in production.
# Production example: https://miracletimes.in,https://www.miracletimes.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=1048576
PUBLIC_BASE_URL=http://localhost:4000

SCHEDULE_INTERVAL_MS=60000

# Vercel Deploy Hook URL (Project → Settings → Git → Deploy Hooks).
# Required (HTTPS) when NODE_ENV=production — publishes rebuild the static site.
# Leave empty locally so admin saves do not fire production deploys.
# Never commit a real hook URL. Never use NEXT_PUBLIC_* for this value.
# FRONTEND_DEPLOY_HOOK_URL=
# FRONTEND_DEPLOY_DEBOUNCE_MS=45000
