# Use another free port (e.g. 4001) if 4000 is already taken locally.
PORT=4000
NODE_ENV=development
# Listen address. Production defaults to 127.0.0.1 when unset (Nginx-safe).
# Development may leave empty (all interfaces). PaaS needing all interfaces:
# LISTEN_HOST=0.0.0.0
# LISTEN_HOST=127.0.0.1

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Empty OK for local MySQL. Required (non-empty) when NODE_ENV=production.
DB_PASSWORD=
DB_NAME=miracle_times

# Development: any string ≥16 chars. Production: unique random secret ≥32 chars.
# Generate: openssl rand -base64 48
# Never reuse example placeholders in production — the API will refuse to start.
JWT_SECRET=change-me-to-a-long-random-string
# Cookie maxAge matches this value (e.g. 12h, 1d, 30m, or seconds like 43200).
JWT_EXPIRES_IN=12h
COOKIE_NAME=mt_token
# Optional. Prefer host-only cookies on api.miracletimes.in.
# Set only when intentionally sharing across subdomains (e.g. .miracletimes.in).
# COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
# Comma-separated exact origins (no wildcards). Required + HTTPS-only in production.
# Production example: https://miracletimes.in,https://www.miracletimes.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=1048576
PUBLIC_BASE_URL=http://localhost:4000

SCHEDULE_INTERVAL_MS=60000

# On-demand Next.js cache revalidation (replaces static-export rebuild webhook).
# Required when NODE_ENV=production. Prefer loopback to Next on the same host.
# Production example: http://127.0.0.1:3000/api/revalidate/
# Must match Next REVALIDATE_TOKEN. Never commit a real token.
# Leave empty locally so admin saves do not call a remote revalidator.
# CACHE_REVALIDATE_URL=
# CACHE_REVALIDATE_TOKEN=
# CACHE_REVALIDATE_DEBOUNCE_MS=5000

# Media storage. Default local preserves existing uploads on disk.
# STORAGE_PROVIDER=local
# For S3-compatible providers (Cloudflare R2 / Contabo Object Storage / AWS):
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=miracle-times-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true
