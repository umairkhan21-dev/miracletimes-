# Public API base URL used by the Next.js frontend (no trailing slash).
# Never put DB credentials, JWT secrets, or admin passwords here.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Shared secret for POST /api/revalidate (server-only; never NEXT_PUBLIC_*).
# Required in production next start. Leave empty in local `next dev` if unused.
# REVALIDATE_TOKEN=

# Optional comma-separated extra image hostnames for next/image remotePatterns.
# NEXT_IMAGE_REMOTE_HOSTS=cdn.miracletimes.in
